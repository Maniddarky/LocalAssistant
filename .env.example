# Optional language model. Leave these blank to quote PDF passages with no API key.
# Point the base URL at Ollama, LM Studio, or any OpenAI-compatible server.
# Browser settings override the URL and model. A key set here is used only when
# the browser key is empty, and it is never written into the page.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
